# copy to .env and fill in. .env is gitignored - this repo is public, keep it
# that way.

# needs repo + workflow scope.
# a fine-grained PAT will NOT work: it can't create repositories, and the
# golden path fails with "Resource not accessible by personal access token".
# use a classic / OAuth token.
GITHUB_TOKEN=

# for the Kubernetes tab on entity pages. both come from:
#   idp-gitops/scripts/portal-credentials.sh
KUBERNETES_CLUSTER_URL=
KUBERNETES_SA_TOKEN=
